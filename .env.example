# Ant Media Server Connection
AMS_BASE_URL=http://103.255.15.138:5080
AMS_USER=
AMS_PASSWORD=
AMS_TIMEOUT_SECONDS=5.0
AMS_MAX_RETRIES=3

# Background Poller and Log Ingestor
POLL_INTERVAL_SECONDS=5
LOG_RETENTION_DAYS=30
LOG_RETENTION_LIMIT=100
STREAM_METRICS_INTERVAL_SECONDS=5
METRIC_RETENTION_DAYS=30

# Green API WhatsApp notifications
GREEN_API_ENABLED=false
GREEN_API_URL=https://api.green-api.com
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
# One or more Green API chat IDs, separated by commas.
# Personal chat: 628123456789@c.us; group chat: 120363xxxxxxxxxx@g.us
GREEN_API_CHAT_IDS=

# Database (MySQL Laragon)
DATABASE_URL=mysql+aiomysql://root:@localhost:3306/ams_monitoring
SYNC_DATABASE_URL=mysql+pymysql://root:@localhost:3306/ams_monitoring
# For SQLite, replace both URLs with:
# DATABASE_URL=sqlite+aiosqlite:///./cctv_monitoring.db
# SYNC_DATABASE_URL=sqlite:///./cctv_monitoring.db

# Application Settings
APP_NAME="CCTV Monitoring Dashboard"
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-this-with-a-random-secret
APP_HOST=0.0.0.0
APP_PORT=8050