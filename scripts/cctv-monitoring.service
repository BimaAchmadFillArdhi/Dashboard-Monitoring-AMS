[Unit]
Description=Dashboard Monitoring AMS FastAPI Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/Dashboard-Monitoring-AMS
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
KillMode=process
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
